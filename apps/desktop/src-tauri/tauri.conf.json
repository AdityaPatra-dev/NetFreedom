{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetFreedom",
  "version": "2.0.0",
  "identifier": "com.adityapatra.netfreedom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetFreedom",
        "width": 1000,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
